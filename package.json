{
  "name": "import-file-to-folder",
  "displayName": "Import file to folder",
  "description": "Imports a file to the chosen folder",
  "publisher": "tiagoaspina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tpina/import-file-to-folder"
  },
  "icon": "images/import-to-folder.png",
  "version": "0.12.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "extension.importFileToFolder",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "explorerResourceIsFolder"
      }
    ],
    "commands": [
      {
        "command": "extension.importFileToFolder",
        "title": "Import file to folder"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "command": "extension.importFileToFolder",
          "group": "2_workspace"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.11.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "typescript": "^5.9.3"
  }
}
